model User {
    userid Int @id @default(autoincrement())
    createdAt DateTime @default(now())
}

model Genre{
    genreid Int @id @default(autoincrement())
    name String @unique
    createdAt DateTime @default(now())
}

model Book {
  bookid Int @id @default(autoincrement())
  title String 
  author String 
  createdAt DateTime @default(now())
}


model Interest {
  interestid Int @id @default(autoincrement())
  name String @unique 
  createdAt DateTime @default(now())
}

model HasInterest{
    interestid Int 
    userid Int 
    createdAt DateTime @default(now())

    @@id([interestid, userid])
}

model BelongsTo {
    bookid Int 
    genreid Int 
    createdAt DateTime @default(now())

    @@id([bookid, genreid])
}

model Prefer {
    userid Int 
    genreid Int 
    createdAt DateTime @default(now())


    @@id([userid, genreid])
}

model IntrestBook {
    bookid Int 
    interestid 
    createdAt DateTime @default(now())

    @@id([bookid, interestid])
}

