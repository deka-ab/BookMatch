generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  userid      Int           @id @default(autoincrement())
  createdAt   DateTime      @default(now())
  hasInterest HasInterest[]
  preferences Prefer[]
  goals UserGoal[]
}

model Goal{
  goalid Int @id @default(autoincrement())
  name String @unique 
  description String 
  createdAt   DateTime      @default(now())
  users UserGoal[]
}

model UserGoal{
  userid Int 
  goalid Int 
  createdAt   DateTime      @default(now())

  user User @relation(fields: [userid], references: [userid], onDelete: Cascade)
  goal Goal @relation(fields: [goalid], references: [goalid], onDelete: Cascade)

  @@id([userid, goalid])

}

model Genre {
  genreid   Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  books       BelongsTo[]
  preferences Prefer[]
}

model Book {
  bookid    Int      @id @default(autoincrement())
  openLibraryId String @unique 
  title     String
  author    String?
  publishedYear Int?
  coverId Int?
  createdAt DateTime @default(now())

  interests InterestBook[]
  genres    BelongsTo[]
}

model Interest {
  interestid Int      @id @default(autoincrement())
  name       String   @unique
  createdAt  DateTime @default(now())

  hasInterest HasInterest[]
  books       InterestBook[]
}

model HasInterest {
  interestid Int
  userid     Int
  createdAt  DateTime @default(now())

  user User @relation(fields: [userid], references: [userid])

  interest Interest @relation(fields: [interestid], references: [interestid])

  @@id([interestid, userid])
}

model BelongsTo {
  bookid    Int
  genreid   Int
  createdAt DateTime @default(now())

  book Book @relation(fields: [bookid], references: [bookid], onDelete: Cascade)
  genre Genre @relation(fields: [genreid], references: [genreid], onDelete: Cascade)

  @@id([bookid, genreid])
}

model Prefer {
  userid    Int
  genreid   Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userid], references: [userid])
  genre Genre @relation(fields: [genreid], references: [genreid])

  @@id([userid, genreid])
}

model InterestBook {
  bookid     Int
  interestid Int
  createdAt  DateTime @default(now())

  book Book @relation(fields: [bookid], references: [bookid], onDelete: Cascade)
  interest Interest @relation(fields: [interestid], references: [interestid], onDelete: Cascade)

  @@id([bookid, interestid])
}
